# Travel Explorer — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to source control.

# ─── Client-side (safe to expose, rate-limited by key) ───────────────────────
# OpenWeather Current Weather API — https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=

# Pexels image search API — https://www.pexels.com/api/
VITE_PEXELS_API_KEY=

# ─── Server-side ONLY (never touches the client bundle) ──────────────────────
# Google Gemini API — https://aistudio.google.com
# Used exclusively in /api/chat and /api/itinerary serverless functions.
GEMINI_API_KEY=

# ─── Optional ─────────────────────────────────────────────────────────────────
# Set to "development" locally, "production" on Vercel (auto-set by Vercel)
NODE_ENV=development
